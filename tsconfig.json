{
  /**
   * Declares that the root solution config owns no source files directly.
   *
   * Detailed behavior:
   * - This config coordinates referenced projects only.
   * - It does not create a second implicit program over the same sources.
   *
   * Architectural decision:
   * Keep `files` empty because the root is an orchestration surface, not a compile target.
   *
   * Example:
   * "files": []
   */
  "files": [],

  /**
   * Description:
   * Stops solution traversal when the referenced validation producer fails.
   *
   * Architectural decision:
   * Downstream type validation must not continue from an invalid upstream
   * producer state.
   *
   * Example:
   * "stopBuildOnErrors": true
   */
  "stopBuildOnErrors": true,

  /**
   * Exposes only the canonical declaration-validation producer at the root solution layer.
   *
   * Detailed behavior:
   * - Runtime and type-test configs consume the producer separately.
   * - The root solution should not pretend that every consumer lane is also a producer lane.
   *
   * Architectural decision:
   * Reference only `tsconfig.typecheck.json` because runtime output and
   * Project Reference declarations have separate owners.
   *
   * Example:
   * "references": [{ "path": "./tsconfig.typecheck.json" }]
   */
  "references": [
    {
      "path": "./tsconfig.typecheck.json"
    }
  ]
}
