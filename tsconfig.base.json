{
  /**
   * $schema: Better IDE support (completion/validation).
   */
  "$schema": "https://json.schemastore.org/tsconfig",

  /**
   * CompilerOptions: Canonical universal strict root policy.
   * Sole code owner: CONFIG_TSCONFIG_UNIVERSAL_STRICT_POLICY_REFERENCE_001.
   * This surface is non-emitting; terminal roles own output.
   */
  "compilerOptions": {
    /**
     * Fixed ECMAScript edition (Node 26.2.0 support matrix proves ES2025).
     */
    "target": "ES2025",

    /**
     * Matching fixed standard-library edition; no browser libs in the universal core.
     */
    "lib": ["ES2025"],

    /**
     * Bundler-owned runtime: preserve authored module syntax (tsdown owns emit).
     */
    "module": "Preserve",

    /**
     * Bundler-aware module lookup paired with Preserve.
     */
    "moduleResolution": "Bundler",

    /**
     * Treat every file as a module (no global scripts).
     */
    "moduleDetection": "force",

    /**
     * Typed JSON module imports; runtime data still requires boundary parsing.
     */
    "resolveJsonModule": true,

    /**
     * Package entry points resolve through package.json exports.
     */
    "resolvePackageJsonExports": true,

    /**
     * Package-local # specifiers resolve through package.json imports.
     */
    "resolvePackageJsonImports": true,

    /**
     * Unknown extension imports are rejected.
     */
    "allowArbitraryExtensions": false,

    /**
     * Raw .ts import specifiers are rejected by default.
     */
    "allowImportingTsExtensions": false,

    /**
     * No rewriting of explicit relative TypeScript-extension specifiers.
     */
    "rewriteRelativeImportExtensions": false,

    /**
     * JavaScript files stay outside the TypeScript program.
     */
    "allowJs": false,

    /**
     * No UMD global access from module files.
     */
    "allowUmdGlobalAccess": false,

    /**
     * Ergonomic default imports where external declarations support them.
     */
    "allowSyntheticDefaultImports": true,

    /**
     * Deterministic CJS/ESM interop at package boundaries.
     */
    "esModuleInterop": true,

    /**
     * Value/type import intent stays explicit in source.
     */
    "verbatimModuleSyntax": true,

    /**
     * Every file must be safe for isolated transpilation.
     */
    "isolatedModules": true,

    /**
     * Exact file-name casing across operating systems.
     */
    "forceConsistentCasingInFileNames": true,

    /**
     * Standard ECMAScript class-field initialization semantics.
     */
    "useDefineForClassFields": true,

    /**
     * No replacement lookup for @typescript/lib-* packages.
     */
    "libReplacement": false,

    /**
     * Strict type-checking family enabled.
     */
    "strict": true,

    /**
     * Strict JavaScript semantics in analyzed modules.
     */
    "alwaysStrict": true,

    /**
     * Strictly type-checks bind, call, and apply.
     */
    "strictBindCallApply": true,

    /**
     * Built-in iterator completion values are undefined-aware.
     */
    "strictBuiltinIteratorReturn": true,

    /**
     * Contravariant function-parameter checking.
     */
    "strictFunctionTypes": true,

    /**
     * Null and undefined are explicit states.
     */
    "strictNullChecks": true,

    /**
     * Class fields must be definitely initialized.
     */
    "strictPropertyInitialization": true,

    /**
     * Catch variables are unknown (error paths are trust boundaries).
     */
    "useUnknownInCatchVariables": true,

    /**
     * Omitted optional property vs. present-undefined are distinguished.
     */
    "exactOptionalPropertyTypes": true,

    /**
     * Rejects implicitly inferred any types.
     */
    "noImplicitAny": true,

    /**
     * Rejects an implicitly typed this value.
     */
    "noImplicitThis": true,

    /**
     * Requires explicit override markers on overridden members.
     */
    "noImplicitOverride": true,

    /**
     * Requires all non-void code paths to return explicitly.
     */
    "noImplicitReturns": true,

    /**
     * Reports unintended switch-case fallthrough.
     */
    "noFallthroughCasesInSwitch": true,

    /**
     * Bracket access for index-signature-only values.
     */
    "noPropertyAccessFromIndexSignature": true,

    /**
     * Adds undefined to indexed-access results that may miss a key.
     */
    "noUncheckedIndexedAccess": true,

    /**
     * Reports unresolved side-effect-only imports.
     */
    "noUncheckedSideEffectImports": true,

    /**
     * Reports unused local declarations.
     */
    "noUnusedLocals": true,

    /**
     * Reports unused function parameters.
     */
    "noUnusedParameters": true,

    /**
     * Provably unreachable code is a compiler error.
     */
    "allowUnreachableCode": false,

    /**
     * Unused labels are a compiler error.
     */
    "allowUnusedLabels": false,

    /**
     * Third-party declaration files are checked, never suppressed.
     */
    "skipLibCheck": false,

    /**
     * Full semantic typechecking stays enabled.
     */
    "noCheck": false,

    /**
     * The universal root policy surface never emits artifacts.
     */
    "noEmit": true,

    /**
     * A specialized emitting role never writes artifacts when type errors exist.
     */
    "noEmitOnError": true,

    /**
     * Ambient type packages stay opt-in; host globals belong to the narrowest role.
     */
    "types": [],

    /**
     * Domain-scoped repository-owned aliases (physical ./ prefix, no baseUrl —
     * baseUrl is deprecated in TypeScript 6). Package-owned top-level specifiers
     * (#pkg, #docs, #scripts) live in package.json imports, never here.
     */
    "paths": {
      "@application/*": ["./src/application/*"],
      "@cache": ["./src/cache/index.ts"],
      "@cache/*": ["./src/cache/*"],
      "@domain/*": ["./src/domain/*"],
      "@configs/*": ["./src/configs/*"],
      "@infrastructure/*": ["./src/infrastructure/*"],
      "@loaders/*": ["./src/loaders/*"],
      "@mocks/*": ["./__mocks__/*"],
      "@modules/*": ["./src/modules/*"],
      "@observability/*": ["./src/observability/*"],
      "@shared/*": ["./src/shared/*"],
      "@test/*": ["./test/*"],
      "@tooling/*": ["./tooling/*"]
    }
  },

  /**
   * Exclude: dependency trees, generated output, build state, and caches
   * never become implicit application source.
   */
  "exclude": ["node_modules", "dist", "out", "build", ".tsbuild", ".cache"]
}
