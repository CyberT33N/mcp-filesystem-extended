{
  /**
   * $schema: Better IDE support (completion/validation).
   */
  "$schema": "https://json.schemastore.org/tsconfig",

  /**
   * Extends: Reuse the Node-hosted runtime semantics; runtime tests are
   * consumers of that surface, not a separate compiler universe.
   */
  "extends": "./tsconfig.node.json",

  /**
   * References: Bind runtime tests explicitly to the declaration-validation
   * producer graph instead of duplicating source ownership.
   */
  "references": [
    {
      "path": "./tsconfig.typecheck.json"
    }
  ],

  /**
   * CompilerOptions: Runtime-test consumer deltas.
   */
  "compilerOptions": {
    /**
     * Composite: Runtime tests do not own output artifacts.
     */
    "composite": false,

    /**
     * NoEmit: This lane type-checks only; it emits neither JavaScript nor declarations.
     */
    "noEmit": true,

    /**
     * Types: Only the Vitest and Node globals this lane truly owns.
     */
    "types": ["vitest/globals", "node"]
  },

  /**
   * Include: Test sources and shared testing constants; runtime and declaration
   * source ownership stays with the Node leaf and the typecheck producer.
   */
  "include": [
    "test/**/*.ts",
    "tooling/testing/constants/**/*.ts"
  ]
}
