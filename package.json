{
  "name": "mcp-filesystem-extended",
  "version": "1.2.2",
  "private": true,
  "description": "MCP server for extended filesystem access",
  "license": "MIT",
  "author": "CyberT33N",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#pkg": "./package.json",
    "#docs": "./docs",
    "#scripts": "./scripts"
  },
  "homepage": "https://github.com/t33n-software/filesystem-mcp",
  "bugs": "https://github.com/t33n-software/filesystem-mcp/issues",
  "bin": {
    "mcp-filesystem-extended": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "directories": {
    "lib": "dist",
    "doc": "docs",
    "test": "test"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__/"
  ],
  "scripts": {
    "prebuild": "pnpm test:build-gate",
    "build": "tsdown",
    "test": "vitest run",
    "test:build-gate": "pnpm test:unit && pnpm test:integration && pnpm test:regression",
    "test:integration": "vitest run --project integration",
    "test:regression": "vitest run --project regression",
    "test:unit": "vitest run --project unit",
    "test:update-snapshots": "vitest --update",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -b tsconfig.json",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@js-temporal/polyfill": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@sindresorhus/is": "catalog:",
    "@toon-format/toon": "catalog:",
    "diff": "catalog:",
    "dotenv": "catalog:",
    "es-toolkit": "catalog:",
    "esquery": "catalog:",
    "fast-copy": "catalog:",
    "glob": "catalog:",
    "globals": "catalog:",
    "ignore": "catalog:",
    "minimatch": "catalog:",
    "pino": "catalog:",
    "piscina": "catalog:",
    "radash": "catalog:",
    "remeda": "catalog:",
    "semver": "catalog:",
    "sort-on": "catalog:",
    "ts-essentials": "catalog:",
    "type-fest": "catalog:",
    "zod": "catalog:",
    "zod-to-json-schema": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "error-manager-helper": "catalog:",
    "jest-extended": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "safe-stable-stringify": "catalog:",
    "terser": "catalog:",
    "tsconfig-paths": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.5.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
