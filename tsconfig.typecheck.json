{
  /**
   * $schema: Better IDE support (completion/validation).
   */
  "$schema": "https://json.schemastore.org/tsconfig",

  /**
   * Extends: Reuse the Node-hosted runtime semantics without inheriting its
   * delivery ownership; declaration output stays isolated from runtime output.
   */
  "extends": "./tsconfig.node.json",

  /**
   * CompilerOptions: The only composite producer in the single-project graph.
   * Emits declaration-only validation output into the internal build area.
   */
  "compilerOptions": {
    /**
     * Composite: Enables project-reference build-mode participation.
     */
    "composite": true,

    /**
     * NoEmit: A no-emit config cannot fulfill producer responsibilities.
     */
    "noEmit": false,

    /**
     * EmitDeclarationOnly: Runtime JavaScript remains owned by the bundler.
     */
    "emitDeclarationOnly": true,

    /**
     * Declaration: The graph exposes a real type producer for consumers.
     */
    "declaration": true,

    /**
     * DeclarationMap: Cross-project type navigation for internal artifacts.
     */
    "declarationMap": true,

    /**
     * IsolatedDeclarations: Documented deviation from the canonical producer
     * reference. This repository is a private MCP server whose contracts are
     * zod-inference-driven and whose real declaration artifact is owned by
     * tsdown; this producer is a validation lane only. Full compliance would
     * require manual annotations across the entire schema surface for zero
     * delivery value. Composite graph validation does not require this flag.
     */
    "isolatedDeclarations": false,

    /**
     * SourceMap: This lane emits declarations only and owns no JavaScript maps.
     */
    "sourceMap": false,

    /**
     * OutDir: Validation declarations live outside the runtime distribution.
     */
    "outDir": "./.tsbuild/typecheck",

    /**
     * TsBuildInfoFile: Incremental build state stays in the internal build area.
     */
    "tsBuildInfoFile": "./.tsbuild/tsconfig.typecheck.tsbuildinfo"
  },

  /**
   * Include: Only implementation source enters the graph-validation producer;
   * consumer test source retains separate ownership.
   */
  "include": ["src/**/*.ts"]
}
